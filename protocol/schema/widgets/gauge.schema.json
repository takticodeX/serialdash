{
  "$id": "https://schema.serialdash.dev/v1/widgets/gauge.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Widget: gauge",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/widgetBase"
    }
  ],
  "properties": {
    "k": {
      "const": "gauge"
    },
    "min": {
      "type": "number"
    },
    "max": {
      "type": "number"
    },
    "zones": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/zone"
      }
    }
  },
  "required": ["k", "min", "max"]
}
