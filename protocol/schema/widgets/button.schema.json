{
  "$id": "https://schema.serialdash.dev/v1/widgets/button.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Widget: button (control)",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/widgetBase"
    },
    {
      "$ref": "common.schema.json#/$defs/controlExtras"
    }
  ],
  "properties": {
    "k": {
      "const": "button"
    },
    "hold": {
      "type": "boolean",
      "description": "Send true on press and false on release."
    },
    "label": {
      "type": "string"
    },
    "color": {
      "$ref": "common.schema.json#/$defs/color"
    }
  },
  "required": ["k"]
}
